{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Top 10 Most Expensive Suburbs: House vs Unit Prices",

  "width": 550,
  "height": 450,

  "data": {
    "url": "data/house_q4_2025_melbourne.csv"
  },

  "transform": [
    {
      "lookup": "join_key",
      "from": {
        "data": {
          "url": "data/unit_q4_2025_melbourne.csv"
        },
        "key": "join_key",
        "fields": ["median_price_q4_2025"]
      },
      "as": "unit_price"
    },

    {
      "filter": "datum.median_price_q4_2025 != '' && datum.unit_price != ''"
    },

    {
      "calculate": "toNumber(datum.median_price_q4_2025)",
      "as": "house_price"
    },

    {
      "calculate": "toNumber(datum.unit_price)",
      "as": "unit_price_num"
    },

    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "house_price",
          "order": "descending"
        }
      ]
    },

    {
      "filter": "datum.rank <= 10"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rule"
      },

      "encoding": {
        "y": {
          "field": "suburb",
          "type": "nominal",
          "sort": {
            "field": "house_price",
            "order": "descending"
          },
          "title": "Suburb"
        },

        "x": {
          "field": "unit_price_num",
          "type": "quantitative",
          "title": "Median Price (AUD)"
        },

        "x2": {
          "field": "house_price"
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100,
        "color": "blue"
      },

      "encoding": {
        "y": {
          "field": "suburb",
          "type": "nominal",
          "sort": {
            "field": "house_price",
            "order": "descending"
          }
        },

        "x": {
          "field": "house_price",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "suburb",
            "type": "nominal",
            "title": "Suburb"
          },
          {
            "field": "house_price",
            "type": "quantitative",
            "title": "House Price",
            "format": "$,.0f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100,
        "color": "red"
      },

      "encoding": {
        "y": {
          "field": "suburb",
          "type": "nominal",
          "sort": {
            "field": "house_price",
            "order": "descending"
          }
        },

        "x": {
          "field": "unit_price_num",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "suburb",
            "type": "nominal",
            "title": "Suburb"
          },
          {
            "field": "unit_price_num",
            "type": "quantitative",
            "title": "Unit Price",
            "format": "$,.0f"
          }
        ]
      }
    }
  ]
}
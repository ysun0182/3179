{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "House Price and Sales Activity by Suburb (Q4 2025)",
  "width": 1200,
  "height": 700,

  "layer": [
    {
      "data": {
        "url": "data/melbourne_suburbs.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "#aaaaaa",
        "strokeWidth": 0.5
      }
    },

    {
      "data": {
        "url": "data/map2_house_sales_q4_2025.csv"
      },

      "transform": [
        {
          "filter": "datum.sales_q4_2025 > 0 && datum.median_price_q4_2025 > 0"
        }
      ],

      "mark": {
        "type": "circle",
        "opacity": 1
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "sales_q4_2025",
          "type": "quantitative",
          "title": "House Sales",
          "scale": {
            "range": [25, 1000]
          }
        },

        "color": {
          "field": "median_price_q4_2025",
          "type": "quantitative",
          "title": "Median House Price",
          "scale": {
            "type": "linear",
            "domain": [0, 2000000],
            "range": ["#f7fbff", "#08306b"]
          }
        },
  

        "tooltip": [
          {
            "field": "suburb",
            "type": "nominal",
            "title": "Suburb"
          },
          {
            "field": "median_price_q4_2025",
            "type": "quantitative",
            "title": "Median House Price",
            "format": "$,.0f"
          },
          {
            "field": "sales_q4_2025",
            "type": "quantitative",
            "title": "House Sales"
          }
        ]
      }
    }
  ]
}
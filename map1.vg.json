{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Median Property Prices in Melbourne (Q4 2025)",
  "width": 1200,
  "height": 700,

  "projection": {
    "type": "mercator"
  },

  "params": [
    {
      "name": "Property_Type",
      "value": "House",
      "bind": {
        "input": "select",
        "options": ["House", "Unit"],
        "labels": ["House", "Unit"],
        "name": "Property Type: "
      }
    }
  ],

  "data": {
    "url": "data/melbourne_suburbs.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [
    {
      "lookup": "properties.join_key",
      "from": {
        "data": {
          "url": "data/house_q4_2025_melbourne.csv"
        },
        "key": "join_key",
        "fields": ["median_price_q4_2025"]
      },
      "as": "house_price"
    },

    {
      "lookup": "properties.join_key",
      "from": {
        "data": {
          "url": "data/unit_q4_2025_melbourne.csv"
        },
        "key": "join_key",
        "fields": ["median_price_q4_2025"]
      },
      "as": "unit_price"
    },

    {
      "calculate": "Property_Type == 'House' ? datum.house_price : datum.unit_price",
      "as": "Median Price"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "geoshape"
      },

      "encoding": {
        "color": {
          "field": "Median Price",
          "type": "quantitative",
          "title": "Median Price (AUD)",
          "scale": {
            "type": "threshold",
            "domain": [
              600000,
              800000,
              1000000,
              1300000,
              1700000,
              2500000
            ],
            "scheme": "blues"
          },

          "legend": {
            "format": "$,.0f"
          }
        },

        "tooltip": [
          {
            "field": "properties.suburb",
            "type": "nominal",
            "title": "Suburb"
          },
          {
            "field": "Median Price",
            "type": "quantitative",
            "title": "Median Price",
            "format": "$,.0f"
          }
        ]
      }
    },

    {
      "data": {
